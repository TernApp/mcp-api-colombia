# Solo para el modo remoto en el VPS (src/http.js). El modo local usa RAPIDAPI_KEY del usuario.
PORT=3102
HOST=127.0.0.1
TRUST_PROXY=1
RATE_LIMIT_PER_MIN=120
# Host público de la API en RapidAPI (X-RapidAPI-Host de Code Snippets)
RAPIDAPI_HOST=
# Enlace a la ficha de la API en RapidAPI (aparece en los mensajes de error)
RAPIDAPI_LISTING_URL=
